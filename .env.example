# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Generator (answers questions)
GENERATOR_BASE_URL=https://api.groq.com/openai/v1
GENERATOR_API_KEY=
GENERATOR_MODEL=qwen/qwen3.8-27b
# "none" = plain instruct mode (no hidden reasoning tokens). Leave empty to send nothing.
GENERATOR_REASONING_EFFORT=none

# Judge (scores groundedness and coverage). Must differ from the generator model.
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-oss-20b
# gpt-oss is a reasoning model: "low" keeps hidden reasoning (billed as output tokens) small.
JUDGE_REASONING_EFFORT=low

# To swap the judge to GPT-4o-mini, change ONLY these lines (and blank the effort):
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=gpt-4o-mini
# JUDGE_REASONING_EFFORT=

# Hosted demo: leave both API keys EMPTY. Visitors supply their own Groq key
# in the UI (bring-your-own-key); it is used per request and never stored or logged.

# Optional API settings (see README, "Run the API with Docker"). All have safe defaults, shown here.
# RAGBENCH_CORS_ORIGINS=["https://your-frontend.example"]   # the UI's origin (default: local dev)
# RAGBENCH_REQUIRE_HTTPS=0          # 1 in hosted mode: refuse API keys over plain HTTP
# RAGBENCH_TRUST_PROXY_HEADERS=0    # 1 only behind a proxy you control
# RAGBENCH_WARM_RETRIEVER=0         # 1 = load the embedding model and index at startup, not on the first live run
# RAGBENCH_MAX_QUESTION_CHARS=500   # longest free-text question accepted
# RAGBENCH_RUN_TIMEOUT_S=240        # budget for one live run, checked between steps
# RAGBENCH_RATE_LIMIT_RUNS=6        # live runs per client IP...
# RAGBENCH_RATE_LIMIT_RUNS_WINDOW_S=600       # ...per this many seconds
# RAGBENCH_RATE_LIMIT_VALIDATE=10   # key validations per client IP...
# RAGBENCH_RATE_LIMIT_VALIDATE_WINDOW_S=60    # ...per this many seconds
# RAGBENCH_MAX_CONCURRENT_RUNS=1    # live runs in flight across all clients (1 keeps a 512 MB server safe)

# Read from the process environment only (not from this file): set them in the shell or the host.
# RAGBENCH_MAX_CONCURRENCY=4        # model calls in flight at once, per process
# RAGBENCH_CHROMA_DIR=data/chroma   # where the Chroma index lives
# RAGBENCH_CACHE_DIR=.cache/llm_cache  # where the LLM response cache lives
