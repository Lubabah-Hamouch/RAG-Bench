     "gold_facts": {
      "items": {
       "$ref": "#/components/schemas/GoldFactOut"
      },
      "type": "array",
      "title": "Gold Facts",
      "default": []
     }
    },
    "type": "object",
    "required": [
     "id",
     "type",
     "question"
    ],
    "title": "QuestionOut"
   },
   "QuestionResultOut": {
