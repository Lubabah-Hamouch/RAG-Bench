     },
     "coverage": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/CoverageOut"
       },
       {
        "type": "null"
       }
      ]
     },
     "fcs": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fcs"
     },
     "lexical": {
      "$ref": "#/components/schemas/LexicalOut"
     },
     "latency_s": {
      "type": "number",
      "title": "Latency S"
     },
     "prompt_tokens": {
      "type": "integer",
      "title": "Prompt Tokens"
     },
     "completion_tokens": {
      "type": "integer",
      "title": "Completion Tokens"
     },
     "calls": {
      "type": "integer",
      "title": "Calls"
     },
     "cost_usd": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Cost Usd"
     },
     "judge_tokens": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Judge Tokens"
     },
     "judge_cost_usd": {
      "anyOf": [
       {
        "type": "number"
       },
       {
