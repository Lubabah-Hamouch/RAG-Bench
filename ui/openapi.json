     },
     "score": {
      "type": "boolean",
      "title": "Score",
      "default": true
     }
    },
    "type": "object",
    "title": "RunRequest"
   },
   "StageOut": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "text": {
      "type": "string",
      "title": "Text"
     }
    },
    "type": "object",
    "required": [
     "name",
     "text"
    ],
    "title": "StageOut"
   },
   "StrategyInfo": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "uses_retrieval": {
      "type": "boolean",
      "title": "Uses Retrieval"
     },
     "calls": {
      "type": "integer",
      "title": "Calls"
     }
    },
    "type": "object",
    "required": [
     "name",
     "label",
     "uses_retrieval",
     "calls"
    ],
    "title": "StrategyInfo"
   },
   "TrialAnswerOut": {
    "properties": {
